rules_version = '2';

// Sylareads – Firestore-Regeln. In der Firebase-Konsole unter
// Firestore Database → Regeln komplett einfügen und „Veröffentlichen“.
// Die App prüft dieselben Dinge noch einmal (src/domain/names.ts, src/domain/presence.ts).

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Kurse, die auf einer Spielerkarte stehen dürfen (CARD_COURSES in src/domain/presence.ts).
    function cardCourses() {
      return ['ru', 'el', 'bn', 'th', 'scripts'];
    }

    // Anzeigenamen: 2–24 Zeichen, Buchstaben jeder Schrift, Ziffern, Leerzeichen und . _ -
    // (NAME_PATTERN in src/domain/names.ts), dazu die Sperrliste.
    function goodName(n) {
      return n is string
        && n.size() >= 2 && n.size() <= 24
        && n.matches('^[\\p{L}\\p{N}][\\p{L}\\p{M}\\p{N} ._-]*$')
        && !n.lower().replace('[ ._-]', '').matches('.*(fuck|cunt|nigg|fotze|hurensohn|wichser|schwuchtel|faggot|hitler|missgeburt|kanake).*')
        && !n.lower().matches('(.*[ ._-])?(arsch|hure|nazi|slut|whore|bitch|shit|spast|neger|retard|rape|porn|sex|admin|moderator|sylareads|geoguessr)([ ._-].*)?');
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // Belohnungen auf der Karte (src/domain/rewards.ts): Emoji je Level, Titel bei Level 1
    // und alle 5 Level, Rahmen alle 10 Level – nur, was das Level schon freigeschaltet hat.
    function goodLook(d) {
      return (!('emoji' in d) || (intIn(d.emoji, 1, 100) && d.emoji <= d.level))
        && (!('title' in d) || (intIn(d.title, 1, 100) && (d.title == 1 || d.title % 5 == 0) && d.title <= d.level))
        && (!('frame' in d) || (intIn(d.frame, 10, 100) && d.frame % 10 == 0 && d.frame <= d.level));
    }

    // Fortschritt: nur der Besitzer, höchstens alle 10 Sekunden, unter 900 KB.
    match /sylareads/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'schema'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.updatedAt == request.time
        && (resource == null || !('updatedAt' in resource.data)
            || request.time > resource.data.updatedAt + duration.value(10, 's'));
    }

    // „Wer ist da“: Angemeldete lesen höchstens 60 Karten pro Abfrage,
    // jeder schreibt nur die eigene Karte, höchstens einmal pro Minute.
    // Karten, die 30 Tage nicht aktualisiert wurden, darf jede angemeldete App löschen
    // (Aufräumen, CARD_KEEP_DAYS in src/domain/presence.ts).
    match /players/{uid} {
      allow list: if request.auth != null && request.query.limit <= 60;
      allow delete: if isOwner(uid)
        || (request.auth != null && resource.data.seen < request.time - duration.value(30, 'd'));
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['v', 'name', 'seen', 'course', 'courses', 'streak', 'level', 'xp', 'tempo', 'emoji', 'title', 'frame'])
        && request.resource.data.v == 2
        && goodName(request.resource.data.name)
        && request.resource.data.seen == request.time
        && (resource == null || request.time > resource.data.seen + duration.value(60, 's'))
        && request.resource.data.course is string
        && (request.resource.data.course == '' || request.resource.data.course in cardCourses())
        && request.resource.data.courses is map
        && request.resource.data.courses.keys().hasOnly(cardCourses())
        && intIn(request.resource.data.streak, 0, 100000)
        && intIn(request.resource.data.level, 1, 999)
        && intIn(request.resource.data.xp, 0, 100000000)
        && (!('tempo' in request.resource.data)
            || (request.resource.data.tempo is map && request.resource.data.tempo.keys().hasOnly(cardCourses())))
        && goodLook(request.resource.data);
    }
  }
}
